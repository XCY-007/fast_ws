<?xml version="1.0" ?>
<sdf version="1.5">
    <world name="default">

        <physics type="ode">
            <max_step_size>0.0005</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>2000</real_time_update_rate>
            <gravity>0 0 -9.81</gravity>
            <ode>
                <solver>
                    <type>quick</type>
                    <iters>50</iters>
                    <sor>1.3</sor>
                </solver>
                <constraints>
                    <cfm>0.0</cfm>
                    <erp>0.2</erp>
                    <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
                    <contact_surface_layer>0.001</contact_surface_layer>
                </constraints>
            </ode>
        </physics>

        <scene>
        <sky>
            <clouds>
                <speed>12</speed>
            </clouds>
        </sky>
        </scene>
        <!-- A global light source -->
        <include>
            <uri>model://sun</uri>
        </include>
        <!-- A ground plane -->
        <include>
            <uri>model://ground_plane</uri>
        </include>
        <!-- environment blocks, obstacles or stairs -->
        <model name="static_environment">
        <static>true</static>
            <!-- 上斜坡：从后往前爬 -->
            <link name="slope_up">
            <pose>-8 -2.0 0.2 0.35 0 0</pose>  <!-- +30° -->
            <collision name="slope_up_collision">
                <geometry>
                <box>
                    <size>2 2 0.1</size>  <!-- 长 Y方向 / 宽 X方向 -->
                </box>
                </geometry>
                <!-- ✨摩擦加在这里 ✨-->
                <surface>
                <friction>
                    <ode>
                    <mu>1.0</mu>   <!-- 越大越防滑 -->
                    <mu2>1.0</mu2>
                    </ode>
                </friction>
                </surface>
            </collision>
            <visual name="slope_up_visual">
                <geometry>
                <box>
                    <size>2 2 0.1</size>
                </box>
                </geometry>
                <material>
                <diffuse>0.421 0.225 0.0 1.0</diffuse>
                </material>
            </visual>
            </link>

            <!-- 平台 -->
            <link name="platform">
            <pose>-8 0.0 0.55 0 0 0</pose> 
            <collision name="platform_collision">
                <geometry>
                <box>
                    <size>2.2 2.2 0.1</size>
                </box>
                </geometry>
            </collision>
            <visual name="platform_visual">
                <geometry>
                <box>
                    <size>2.2 2.2 0.1</size>
                </box>
                </geometry>
                <material>
                <diffuse>0.3 0.3 0.3 1.0</diffuse>
                </material>
            </visual>
            </link>

            <!-- 下斜坡：从平台走下去 -->
            <link name="slope_down">
            <pose>-8 2.0 0.2 -0.35 0 0</pose>  <!-- -30° 反向坡 -->
            <collision name="slope_down_collision">
                <geometry>
                <box>
                    <size>2 2 0.1</size>
                </box>
                </geometry>
            </collision>
            <visual name="slope_down_visual">
                <geometry>
                <box>
                    <size>2 2 0.1</size>
                </box>
                </geometry>
                <material>
                <diffuse>0.421 0.225 0.0 1.0</diffuse>
                </material>
            </visual>
            </link>


            <link name="static_box_0">
                <pose>-4 -1.0 0.2 0 0 0</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>2 2 0.4</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="static_box_visual">
                    <geometry>
                        <box>
                            <size>2 2 0.4</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.2 0.2 1.0</ambient>
                        <diffuse>.421 0.225 0.0 1.0</diffuse>
                    </material>
                </visual>
            </link>
            <link name="static_box_1">
                <pose>-4 1.0 0.35 0 0 0</pose>
                <collision name="static_box_collision">
                    <geometry>
                        <box>
                            <size>2 2 0.7</size>
                        </box>
                    </geometry>
